# ==============================================================================
# Smart Contract Analyser - Frontend Environment Configuration (.env.example)
# ==============================================================================
# In Vercel, configure this under Project Settings -> Environment Variables.
#
# Build-time API Base URL pointing to the deployed backend Vercel project:
# Example: https://smart-contract-analyser-backend.vercel.app
# Leave empty for local development (defaults to http://127.0.0.1:8000).
# ==============================================================================
VITE_API_BASE_URL=
