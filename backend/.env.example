# ==============================================================================
# Smart Contract Analyser - Backend Environment Configuration (.env.example)
# ==============================================================================
# Configure these variables in your backend environment (Render, Railway, Fly.io,
# Docker, or local development in backend/.env).
# ==============================================================================

# CORS Configuration: Exact deployed frontend origin (e.g., https://your-frontend.vercel.app)
# Comma-separated if multiple domains are used. Credentials are enabled; do not use wildcard (*).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Session Security (Part 2)
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens. Must be set to a strong random string in production!
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# JWT session token lifetime in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Set to 'true' in production with HTTPS to ensure HttpOnly cookies are transmitted securely.
# Leave 'false' for local HTTP development.
JWT_COOKIE_SECURE=false

# Development-only seed accounts flag. Set to 'true' or '1' ONLY in development to seed
# test accounts (admin@example.com / auditor@example.com). MUST BE 'false' IN PRODUCTION!
SEED_DEV_ACCOUNTS=false

# Optional: Direct public HTTPS URL to download model.safetensors into ephemeral storage (/tmp)
# Required if model weights are not bundled in the deployment due to bundle size limits.
MODEL_WEIGHTS_URL=

# Optional: Expected SHA-256 checksum of model.safetensors for download validation
EXPECTED_MODEL_SHA256=4c5d1c1caf6f42e38173d6fc1b69a924cf2ad93e0188e0f5bb057ac0b73d972e

# Maximum accepted contract source length in bytes (1MB default = 1048576)
MAX_FILE_SIZE_BYTES=1048576

# Maximum concurrent analysis executions allowed per function instance (default: 1)
MAX_CONCURRENT_ANALYSIS_JOBS=1

# Rate limiting: Maximum submissions permitted per client IP per minute (default: 20)
RATE_LIMIT_PER_MINUTE=20

# Ephemeral in-memory analysis cache TTL in minutes (default: 30)
ANALYSIS_TTL_MINUTES=30

# Secure File Storage & Data Lifecycle (Part 4)
# ------------------------------------------------------------------------------
# Storage backend provider: 'local' (default, free, local filesystem) or 's3' (S3-compatible)
STORAGE_BACKEND=local

# Local storage directory path (default: backend/data/storage)
STORAGE_DIR=backend/data/storage

# Data retention policy in days before files and analyses are eligible for retention cleanup (default: 30)
DATA_RETENTION_DAYS=30

# Optional: S3-Compatible Cloud Storage (Cloudflare R2, MinIO, AWS S3, Wasabi)
# Active only when STORAGE_BACKEND=s3. Free tiers include Cloudflare R2 (10GB/mo free, zero egress)
# and MinIO (free self-hosted). No paid accounts are required.
# S3_BUCKET_NAME=my-smart-contract-storage-bucket
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto


