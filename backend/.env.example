# ==============================================================================
# Smart Contract Analyser - Backend Environment Configuration (.env.example)
# ==============================================================================
# In the Local Single-User Edition, configuring a .env file is OPTIONAL.
# Safe local loopback defaults (127.0.0.1:8000) are active automatically.
# You only need this file if you wish to override default local directories.
# ==============================================================================

# Local Network & CORS Configuration
# ------------------------------------------------------------------------------
# Restrictive local frontend origins allowed to connect to the backend.
# Binding is locked to loopback (127.0.0.1).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Concurrency Throttling (Local Machine Protection)
# ------------------------------------------------------------------------------
# Maximum simultaneous neural Legal-BERT / SHAP inference tasks on CPU.
MAX_CONCURRENT_ANALYSIS_JOBS=1

# Local File Storage Locations
# ------------------------------------------------------------------------------
# Local filesystem directory where uploaded Solidity files are stored.
STORAGE_DIR=backend/data/storage

# Legal-BERT Model Checkpoint (Verified Public Release Asset)
# ------------------------------------------------------------------------------
# Verified download URL and SHA-256 hash used by scripts/setup_model.py
MODEL_WEIGHTS_URL=https://github.com/AroKrishna/Smart_Contract_Analyser/releases/download/v3.3.0/model.safetensors
EXPECTED_MODEL_SHA256=4c5d1c1caf6f42e38173d6fc1b69a924cf2ad93e0188e0f5bb057ac0b73d972e
