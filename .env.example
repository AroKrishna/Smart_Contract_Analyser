# ==============================================================================
# Smart Contract Analyser - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the services or configure these variables
# directly in your cloud hosting provider's dashboard (Render, Railway, Fly.io, etc.).
# ==============================================================================

# Backend API Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# In production, replace with your exact deployed domain (e.g., https://sca.example.com).
# Credentials are enabled; wildcard origins (*) are prohibited.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# Authentication & Session Security (Part 2)
# ------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens. Must be set to a strong random string in production!
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# JWT session token lifetime in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Set to 'true' in production with HTTPS to ensure HttpOnly cookies are transmitted securely.
# Leave 'false' for local HTTP development.
JWT_COOKIE_SECURE=false

# Development-only seed accounts flag. Set to 'true' or '1' ONLY in development to seed
# test accounts (admin@example.com / auditor@example.com). MUST BE 'false' IN PRODUCTION!
SEED_DEV_ACCOUNTS=false

# Concurrency & Rate Limiting (Server Protection for Anonymous Public Users)
# ------------------------------------------------------------------------------
# Maximum number of concurrent deep learning / XAI analysis jobs running in background.
MAX_CONCURRENT_ANALYSIS_JOBS=2

# Maximum submissions allowed per client IP per sliding 60-second window.
RATE_LIMIT_PER_MINUTE=10

# Maximum file size accepted in bytes (1MB default = 1048576)
MAX_FILE_SIZE_BYTES=1048576

# Ephemeral Retention Policy (In-Memory Only, No Database)
# ------------------------------------------------------------------------------
# Time-To-Live in minutes before temporary analysis reports are automatically expired.
ANALYSIS_TTL_MINUTES=30

# Maximum number of completed analyses retained in memory (FIFO eviction policy).
MAX_STORED_ANALYSES=100

# Frontend Build Configuration
# ------------------------------------------------------------------------------
# Backend API base URL for the deployed frontend.
# Required in production when frontend is on Vercel and backend is hosted separately.
# Example: https://sca-backend.onrender.com
VITE_API_BASE_URL=

# Legal-BERT Model Weights Acquisition (Optional for Container Hosts)
# ------------------------------------------------------------------------------
# Direct HTTPS URL to download model.safetensors on container boot if missing.
# Example: https://github.com/AroKrishna/Smart_Contract_Analyser/releases/download/v3.3.0/model.safetensors
MODEL_WEIGHTS_URL=

# Expected SHA-256 checksum of model.safetensors for download validation
EXPECTED_MODEL_SHA256=4c5d1c1caf6f42e38173d6fc1b69a924cf2ad93e0188e0f5bb057ac0b73d972e

# Automatically run training on container startup if weights file is missing (0 = false, 1 = true).
AUTO_TRAIN_ON_STARTUP=0

# Secure File Storage & Data Lifecycle (Part 4)
# ------------------------------------------------------------------------------
# Storage backend provider: 'local' (default, free, local filesystem) or 's3' (S3-compatible)
STORAGE_BACKEND=local

# Local storage directory path (default: backend/data/storage)
STORAGE_DIR=backend/data/storage

# Data retention policy in days before files and analyses are eligible for retention cleanup (default: 30)
DATA_RETENTION_DAYS=30

# Optional: S3-Compatible Cloud Storage (Cloudflare R2, MinIO, AWS S3, Wasabi)
# Active only when STORAGE_BACKEND=s3. Free tiers include Cloudflare R2 (10GB/mo free, zero egress)
# and MinIO (free self-hosted). No paid accounts are required.
# S3_BUCKET_NAME=my-smart-contract-storage-bucket
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto


