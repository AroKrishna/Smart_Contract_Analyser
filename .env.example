# ==============================================================================
# Smart Contract Analyser - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the services or configure these variables
# directly in your cloud hosting provider's dashboard (Render, Railway, Fly.io, etc.).
# ==============================================================================

# Backend API Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# In production, replace with your exact deployed domain (e.g., https://sca.example.com).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# Concurrency & Rate Limiting (Server Protection for Anonymous Public Users)
# ------------------------------------------------------------------------------
# Maximum number of concurrent deep learning / XAI analysis jobs running in background.
MAX_CONCURRENT_ANALYSIS_JOBS=2

# Maximum submissions allowed per client IP per sliding 60-second window.
RATE_LIMIT_PER_MINUTE=10

# Maximum file size accepted in bytes (1MB default = 1048576)
MAX_FILE_SIZE_BYTES=1048576

# Ephemeral Retention Policy (In-Memory Only, No Database)
# ------------------------------------------------------------------------------
# Time-To-Live in minutes before temporary analysis reports are automatically expired.
ANALYSIS_TTL_MINUTES=30

# Maximum number of completed analyses retained in memory (FIFO eviction policy).
MAX_STORED_ANALYSES=100

# Frontend Build Configuration
# ------------------------------------------------------------------------------
# Optional backend API base URL if the frontend is hosted on a separate domain.
# If left empty, the frontend uses relative requests ("/api/...") via reverse proxy.
# Example: https://sca-api.onrender.com
VITE_API_BASE_URL=
